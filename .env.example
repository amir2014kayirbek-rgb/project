# Скопируйте в .env и заполните (файл .env не попадает в git)
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ для внутренних методов API (бот → API). Обязателен, если API слушает не только localhost
# (`cli serve --host 0.0.0.0` без ключа не запустится). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARALSHIELD_INTERNAL_KEY=
# «Перец» для HMAC-хеша идентификаторов в обратной связи. Задайте один раз и не меняйте,
# иначе старые записи перестанут сопоставляться. Без него создаётся случайное значение вне git
# (с предупреждением в журнале). Сгенерировать так же, как ключ выше.
# ARALSHIELD_HASH_PEPPER=
# Метка карты «Глаза» (файлы data/eye/*_<метка>.*, reports/eye_metrics_<метка>.json); по умолчанию 2025v2
# ARALSHIELD_EYE_TAG=2025v2
# Дополнительные имена хоста для API/панели (через запятую), например IP в локальной сети или домен.
# Без них принимаются только localhost/127.0.0.1 (защита от DNS-rebinding; чужой Host → 400).
# ARALSHIELD_ALLOWED_HOSTS=192.168.1.10,aralshield.local
# Каталог данных (по умолчанию ./data); удобно для тестов на временной копии
# ARALSHIELD_DATA=
# SMS-шлюз провайдера (без него SMS складываются в data/outbox)
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
# Ограничение запросов к API в минуту на IP
ARALSHIELD_RATE_LIMIT=120
# ---- только для сервера (docker compose, см. docs/HOSTING.md)
# Домен для HTTPS (Caddy); добавьте его же в ARALSHIELD_ALLOWED_HOSTS
DOMAIN=
# Время ежедневного выпуска и вечерней рассылки по местному времени UTC+5 (пусто — вечерней нет)
ARALSHIELD_DAILY_AT=05:30
ARALSHIELD_EVENING_AT=18:00
