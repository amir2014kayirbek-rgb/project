# окружения
.venv/
__pycache__/
*.pyc
.pytest_cache/
frontend/node_modules/
frontend/dist/
.env
# сырые и тяжёлые данные — восстанавливаются командой `python -m aralshield.cli all`
data/raw/*
!data/raw/era5/
data/raw/era5/*
# роза ветров ERA5 для «Щита» (3 МБ) — чтобы сервер не скачивал её при запуске
!data/raw/era5/wind_*.parquet
data/eye/*.tif
data/eye/*.npy
data/aralshield.sqlite*
data/outbox/
models/eye_rf.joblib
reports/pipeline.log
# артефакты сборки и журналы
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
reports/logs/
# полный текст кейса (право на публикацию — решение лидера)
reports/qa/_spec_report_text.txt
reports/run_*.log
.claude/
