  "definitions": {
    "E_ij": "S_i·P_ij·exp(−d_ij/L)·N_j при d_ij ≤ 300 км, иначе 0",
    "M_i": "clip((0.35·r(NDVI) + 0.25·r(NMDI) + 0.25·(1−r(SI)) + 0.15·(1−r(TGSI)) − 0.2)/0.6, 0, 1), r — процентильный ранг по валидным ячейкам; доступность от дорог не учтена (нет слоя, W9). M — относительный ранг, а не агрономический порог: доля M > 0.5 заметно выше ≈15% пригодной площади по Kim et al. (2020)",
    "class": "высокий: верхние 10% приоритета и M ≥ 0.4; надёжный высокий: плюс устойчивость ≥ 0.8; средний: 70–90% (или верхние 10% при M < порога); низкий: остальное",
    "protected_population": "население пунктов, которые вместе получают 80% вклада ячейки (по убыванию E_ij); 0, если вклада нет",
    "protects": "пункт с наибольшим E_ij; пусто, если вклада нет",
    "scenario_area": "точная площадь: последняя ячейка засаживается частично"
  },
